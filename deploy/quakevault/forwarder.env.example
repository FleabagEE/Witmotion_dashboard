# Ingest credential for the spool forwarder.
#
# Install to /etc/quakevault/forwarder.env with mode 0600, owned by root:
#
#   sudo install -m 0600 -o root -g root forwarder.env.example /etc/quakevault/forwarder.env
#
# Issue a token on the backend (shown once):
#
#   php artisan appliance:token QV-EDGE-001
#
# The token carries the 'ingest' ability only: it can submit measurements, but
# cannot read history or change configuration.

QV_INGEST_TOKEN=replace-me
